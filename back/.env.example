# Copier ce fichier en .env et adapter les valeurs pour l'environnement local/prod.
# Ne jamais committer le fichier .env (il est exclu via .gitignore).

APP_ENV=dev

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yawasla
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Pour utiliser sqlite à la place (dev/tests uniquement, non recommandé en prod) :
# DB_CONNECTION=sqlite
# DB_DATABASE=database.sqlite
# Le fichier est automatiquement placé dans var/{APP_ENV}/db/

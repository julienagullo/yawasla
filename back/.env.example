# Copier ce fichier en .env et adapter les valeurs.
# APP_ENV = dev ou prod uniquement

APP_ENV=dev
# URL publique de l'app (sans / final), pour les liens des mails. Ex : https://beta.yawasla.org
APP_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yawasla
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SQLite (dev uniquement, non recommandé en prod) :
# DB_CONNECTION=sqlite
# DB_DATABASE=database.sqlite

# Mail SMTP
#   Format : schema://utilisateur:motdepasse:hote:port
#   schema smtps = TLS implicite (port 465) ; smtp = STARTTLS (port 587)
#   Exemple OVH : SMTP=smtps://noreply@yawasla.org:motdepasse:ssl0.ovh.net:465
MAIL_SMTP=
MAIL_FROM_ADDRESS=noreply@yawasla.org
MAIL_FROM_NAME=Yawasla
